<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/NovusVision.ico</ApplicationIcon>
    <Product>NovusVision</Product>
    <Version>1.1.0</Version>
    <Company>Novus Mercatura</Company>
    <Description>Desktop fog overlay and click confirmation for Windows.</Description>
    <Copyright>Copyright © 2026 Novus Mercatura. CC BY 4.0.</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="assets/NovusVision.ico" />
  </ItemGroup>
</Project>
