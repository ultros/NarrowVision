<Window x:Class="NovusVision.DecisionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource {x:Type Window}}"
    Title="NovusVision Click Guard" Width="410" Height="252"
    WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
    ShowActivated="False" ShowInTaskbar="False" Topmost="True">
    <Border Background="{StaticResource Panel}" BorderBrush="#628BB1" BorderThickness="1" CornerRadius="13" Padding="17,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <TextBlock x:Name="Countdown" DockPanel.Dock="Right" Foreground="{StaticResource Amber}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Allow this click?"/>
            </DockPanel>
            <TextBlock x:Name="LocationText" Grid.Row="1" Style="{StaticResource SecondaryText}"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,8"/>
            <Border Grid.Row="2" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Edge}"
                    BorderThickness="1" CornerRadius="7" Padding="9,6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TargetName" FontWeight="SemiBold" MaxHeight="37" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TargetNote" Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <UniformGrid Grid.Row="3" Columns="2" Margin="0,10,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource PrimaryButton}"
                        Click="CancelClicked" Margin="0,0,4,0"/>
                <Button x:Name="ProceedButton" Content="Proceed once" IsEnabled="False"
                        Click="ProceedClicked" Margin="4,0,0,0"/>
            </UniformGrid>
            <TextBlock x:Name="KeyHint" Grid.Row="4" Margin="0,7,0,0" Style="{StaticResource SecondaryText}"/>
        </Grid>
    </Border>
</Window>
