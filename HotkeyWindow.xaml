<Window x:Class="NovusVision.HotkeyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource {x:Type Window}}"
    Title="NovusVision keyboard shortcuts" Width="495" SizeToContent="Height"
    ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Keyboard shortcuts"/>
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0"
                Text="Select a shortcut to record a replacement. Press Backspace while recording to disable it."/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                CornerRadius="9" Padding="12">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,3">
                            <Button DockPanel.Dock="Right" Width="153" Content="{Binding Gesture}"
                                    Tag="{Binding Action}" Click="RecordClicked" AutomationProperties.Name="{Binding AutomationLabel}"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <TextBlock Grid.Row="2" x:Name="Feedback" MinHeight="35" Margin="0,9,0,4"
                   Style="{StaticResource SecondaryText}" AutomationProperties.LiveSetting="Polite"/>
        <DockPanel Grid.Row="3" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Restore defaults" Click="RestoreClicked"/>
            <Button DockPanel.Dock="Right" x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" Click="SaveClicked"/>
            <Button DockPanel.Dock="Right" Content="Cancel" Margin="0,0,7,0" Click="CancelClicked"/>
        </DockPanel>
    </Grid>
</Window>
