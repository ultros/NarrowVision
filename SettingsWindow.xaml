<Window x:Class="NovusVision.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NovusVision"
    Style="{StaticResource {x:Type Window}}"
    Title="NovusVision · Novus Mercatura" Icon="/NovusVision;component/assets/NovusVision.ico"
    Width="950" Height="770" MinWidth="735" MinHeight="540"
    WindowStartupLocation="CenterScreen" Topmost="True">
    <Grid Margin="24,16,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16" LastChildFill="False">
            <Border DockPanel.Dock="Left" Background="#1F3956" BorderBrush="#436786" BorderThickness="1"
                    Width="48" Height="48" CornerRadius="10" Margin="0,0,13,0">
                <Grid Width="26" Height="26">
                    <Ellipse Stroke="{StaticResource Ice}" StrokeThickness="1.25" Margin="1"/>
                    <Ellipse Stroke="{StaticResource Ice}" StrokeThickness="1.15" Margin="7"/>
                    <Ellipse Fill="{StaticResource Ice}" Width="3" Height="3"/>
                </Grid>
            </Border>
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="NovusVision" FontSize="29" FontWeight="SemiBold"/>
                <TextBlock FontSize="12" FontWeight="SemiBold" Margin="1,0,0,0">
                    <Hyperlink Foreground="{StaticResource Ice}" NavigateUri="https://novusmercatura.com"
                               RequestNavigate="OpenCompanySite">NOVUS MERCATURA</Hyperlink>
                </TextBlock>
            </StackPanel>
            <Button x:Name="PauseButton" DockPanel.Dock="Right" VerticalAlignment="Center" Click="PauseClicked"
                    Content="Pause for 5 min"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.64*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18,15">
                        <DockPanel>
                            <CheckBox x:Name="FogSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                AutomationProperties.Name="Fog overlay" Checked="SettingChanged" Unchecked="SettingChanged"/>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Fog overlay"/>
                        </DockPanel>
                        <Grid Margin="0,11,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SecondaryText}" Text="Mode"/>
                                <ComboBox x:Name="Mode" AutomationProperties.Name="Fog mode" SelectionChanged="SettingChanged">
                                    <ComboBoxItem Content="Reveal around cursor"/>
                                    <ComboBoxItem Content="Dim around cursor"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource SecondaryText}" Text="Shape"/>
                                <ComboBox x:Name="Shape" AutomationProperties.Name="Focus shape" SelectionChanged="SettingChanged">
                                    <ComboBoxItem Content="Ellipse"/>
                                    <ComboBoxItem Content="Rounded rectangle"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,2,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Width" VerticalAlignment="Center"/>
                            <Slider x:Name="FogWidth" Grid.Column="1" AutomationProperties.Name="Focus width"
                                    Minimum="100" Maximum="1800" ValueChanged="SettingChanged"/>
                            <TextBlock x:Name="WidthValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="Height" VerticalAlignment="Center"/>
                            <Slider x:Name="FogHeight" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Focus height"
                                    Minimum="100" Maximum="1400" ValueChanged="SettingChanged"/>
                            <TextBlock x:Name="HeightValue" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="Darkness" VerticalAlignment="Center"/>
                            <Slider x:Name="Darkness" Grid.Row="2" Grid.Column="1" AutomationProperties.Name="Fog darkness"
                                    Minimum="0" Maximum="100" TickFrequency="1" SmallChange="1" LargeChange="10" ValueChanged="SettingChanged"/>
                            <TextBlock x:Name="DarknessValue" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Text="Soft edge" VerticalAlignment="Center"/>
                            <Slider x:Name="Feather" Grid.Row="3" Grid.Column="1" AutomationProperties.Name="Soft edge"
                                    Minimum="0" Maximum="180" ValueChanged="SettingChanged"/>
                            <TextBlock x:Name="FeatherValue" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <DockPanel>
                            <CheckBox x:Name="Outline" DockPanel.Dock="Right" Content="Show outline"
                                      Checked="SettingChanged" Unchecked="SettingChanged" Margin="12,0,0,0"/>
                            <ComboBox x:Name="Monitors" AutomationProperties.Name="Displays covered" SelectionChanged="SettingChanged">
                                <ComboBoxItem Content="All displays"/>
                                <ComboBoxItem Content="Display with the cursor"/>
                            </ComboBox>
                        </DockPanel>

                        <Border Height="1" Background="{StaticResource Edge}" Margin="0,15,0,13"/>
                        <DockPanel>
                            <CheckBox x:Name="GuardSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                AutomationProperties.Name="Click Guard" Checked="SettingChanged" Unchecked="SettingChanged"/>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Click Guard"/>
                        </DockPanel>
                        <ComboBox x:Name="Protection" AutomationProperties.Name="Click Guard coverage"
                                  SelectionChanged="SettingChanged" Margin="0,9,0,5">
                            <ComboBoxItem Content="All primary clicks"/>
                            <ComboBoxItem Content="Links, buttons and other controls"/>
                        </ComboBox>
                        <TextBlock x:Name="GuardDescription" Style="{StaticResource SecondaryText}"/>
                        <CheckBox x:Name="Middle" Content="Also guard middle-clicks" Margin="0,7,0,3"
                                  Checked="SettingChanged" Unchecked="SettingChanged"/>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-cancel" VerticalAlignment="Center"/>
                            <Slider x:Name="Timeout" Grid.Column="1" AutomationProperties.Name="Auto-cancel after"
                                Minimum="5" Maximum="45" TickFrequency="1" SmallChange="1" LargeChange="5" ValueChanged="SettingChanged"/>
                            <TextBlock x:Name="TimeoutValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource Edge}" Margin="0,15,0,11"/>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Edit shortcuts" Click="EditShortcutsClicked"
                                    Padding="9,4" MinHeight="28"/>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Keyboard shortcuts"/>
                        </DockPanel>
                        <UniformGrid Columns="2" Rows="2">
                            <TextBlock x:Name="FogShortcut" Style="{StaticResource SecondaryText}" Margin="0,0,5,4"/>
                            <TextBlock x:Name="GuardShortcut" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="SettingsShortcut" Style="{StaticResource SecondaryText}" Margin="0,0,5,0"/>
                            <TextBlock x:Name="PauseShortcut" Style="{StaticResource SecondaryText}"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Preview" Margin="0,0,0,10"/>
                            <local:FogPreview x:Name="Preview" Height="127"/>
                            <UniformGrid Columns="3" Margin="0,10,0,0">
                                <Button Content="Small" Tag="Small" Margin="0,0,5,0" Padding="5" Click="PresetClicked"/>
                                <Button Content="Medium" Tag="Medium" Margin="0,0,5,0" Padding="5" Click="PresetClicked"/>
                                <Button Content="Wide" Tag="Wide" Padding="5" Click="PresetClicked"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                            CornerRadius="12" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Startup and profile"/>
                            <CheckBox x:Name="StartWithWindows" Content="Start with Windows" Margin="0,7,0,3"
                                      Click="StartupClicked"/>
                            <TextBlock x:Name="ProfileStatus" Style="{StaticResource SecondaryText}" Margin="0,4,0,8"/>
                            <Button Content="Save as default" Click="SaveProfileClicked"
                                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"/>
                            <UniformGrid Columns="2" Margin="0,5,0,0">
                                <Button x:Name="LoadProfile" Content="Load default" Margin="0,0,3,0" Click="LoadProfileClicked"/>
                                <Button x:Name="ClearProfile" Content="Clear default" Margin="3,0,0,0" Click="ClearProfileClicked"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close to tray" Click="CloseClicked" Margin="10,0,0,0"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource SecondaryText}"
                       AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
    </Grid>
</Window>
