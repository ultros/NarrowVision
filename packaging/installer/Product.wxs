<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="NovusVision" Manufacturer="Novus Mercatura" Version="$(InstallerVersion)"
           UpgradeCode="0d0b2891-840c-44e2-9696-343f6375969e" Scope="perUser">
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of NovusVision is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="mszip" />
    <Icon Id="ApplicationIcon" SourceFile="../../assets/NovusVision.ico" />
    <Property Id="ARPPRODUCTICON" Value="ApplicationIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://novusmercatura.com" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserPrograms" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="NovusVision">
          <Component Id="ApplicationFiles" Guid="0b3e2f45-7946-48a0-a790-9fe5db939d74">
            <File Id="AppExecutable" Source="$(PayloadDir)\NovusVision.exe" />
            <File Id="AppLicense" Source="$(PayloadDir)\LICENSE.txt" />
            <Shortcut Id="StartMenuEntry" Directory="ProgramMenuFolder" Name="NovusVision"
                      Description="Desktop privacy and click confirmation" Target="[#AppExecutable]"
                      WorkingDirectory="INSTALLFOLDER" Icon="ApplicationIcon" />
            <RemoveFolder Id="RemoveInstallationDirectory" On="uninstall" />
            <RemoveFolder Id="RemoveEmptyProgramsDirectory" Directory="UserPrograms" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\Novus Mercatura\NovusVision"
                           Name="InstalledVersion" Type="string" Value="[ProductVersion]" KeyPath="yes" />
          </Component>
          <Directory Id="NoticesDir" Name="notices">
            <Component Id="RuntimeNotices" Guid="865a05ac-daa8-42ae-a4b5-ab04a9450c9b">
              <File Source="$(PayloadDir)\notices\dotnet-runtime-license.txt" />
              <File Source="$(PayloadDir)\notices\dotnet-runtime-notices.txt" />
              <File Source="$(PayloadDir)\notices\dotnet-desktop-license.txt" />
              <RemoveFolder Id="RemoveNoticesDirectory" On="uninstall" />
              <RegistryValue Root="HKCU" Key="Software\Novus Mercatura\NovusVision"
                             Name="NoticesInstalled" Type="integer" Value="1" KeyPath="yes" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="NovusVisionFeature" Title="NovusVision">
      <ComponentRef Id="ApplicationFiles" />
      <ComponentRef Id="RuntimeNotices" />
    </Feature>

    <CustomAction Id="RemoveOwnedStartupEntry" FileRef="AppExecutable"
                  ExeCommand="--uninstall-cleanup" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RemoveOwnedStartupEntry" Before="RemoveFiles"
              Condition='REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE' />
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(PayloadDir)\License.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="assets/banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="assets/dialog.bmp" />
  </Package>
</Wix>
